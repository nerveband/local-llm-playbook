#!/bin/zsh
set -euo pipefail

SCRIPT_PATH="${0:A}"
SCRIPT_DIR="${SCRIPT_PATH:h}"
REPO_DIR="${SCRIPT_DIR:h}"

INKLING_MODEL="inkling-local/inkling"
ORNITH_SPLASH_MODEL="ornith-splash/ornith"
ORNITH_OMLX_MODEL="omlx-local/Ornith-1.5-35B-A3B-Abliterated-MLX-4bit"
ORNITH_MODEL="$ORNITH_SPLASH_MODEL"
SUROGATE_MODEL="surogate-local/surogate"

MODEL="$INKLING_MODEL"
THINK="medium"
MODEL_EXPLICIT=0
THINK_EXPLICIT=0
USE_SUBAGENTS=0
USE_RULES=1
USE_PHASE_TOOL=1
USE_CONTEXT_GUARD=1
USE_GOAL_GATE=1
USE_CRITIC=1
USE_HASHLINE="auto"
USE_CODEMODE=0
USE_PREFLIGHT=0
AUTO_CRITIC=0
ADAPTIVE_THINK=0
TRACE_ENABLED=0
USE_LEGACY_SPEED=0
NO_AGENTS_MD=0
PRINT_CMD=0
FORCE_PICK=0
NO_AUTOSTART=0
STOP_ALL=0

usage() {
  cat <<'EOF'
Usage: pi-local [pi-local options] [pi options / prompt...]

Lean Pi launcher for local Apple Silicon oMLX and Splash models (Inkling, Ornith, Surogate).
When launched interactively without --inkling, --ornith, --surogate, or --model, shows a live
model picker and automatically swaps/starts the right local server cleanly within
64 GiB RAM.

Options:
  --inkling        Select Inkling 2 Mini directly on port 18089 (skips picker)
  --ornith         Select Ornith 1.5 35B-A3B via ornith-splash on port 18092 (thinking: high)
  --ornith-omlx    Select Ornith 1.5 35B-A3B via legacy oMLX.app on port 8000 (thinking: high)
  --surogate       Select Surogate 3.7 Flash directly on port 18091 (128K, thinking: high)
  --model <id>     Override provider/model id (skips picker)
  --think <level>  Override thinking level: off, minimal, low, medium, high, xhigh, max
  --no-think       Shortcut for --think off
  --hashline       Enable pi-hashline-edit read/edit override (auto-enabled for Surogate & Ornith)
  --no-hashline    Disable pi-hashline-edit even for Surogate & Ornith
  --codemode       Keep Pi's codemode tool enabled (helpful for Python-first models like Inkling)
  --preflight      Inject Turn-0 zero-PII workspace/CSV schema snapshot into static prompt
  --auto-critic    Run one zero-swap fresh-context critic pass before final completion
  --adaptive-think Step thinking tier up +1 after 2 consecutive errors and down after 2 clean turns
  --trace          Write per-turn JSONL flight-recorder traces to /tmp/pi-local-traces/
  --no-goal-gate   Skip local-goal-gate (/goal and .pi-verify.json deliverable verifier)
  --no-critic      Skip local-critic extension (/critic command)
  --subagents      Load isolated pi-subagents extension for multi-step delegation
  --no-phase-tool  Skip local phase_handoff tool / /next-phase extension
  --no-context-guard Skip local-context-guard output trimmer and failure recovery hints
  --legacy-speed   Use global pi-token-speed instead of local-omlx-meter
  --no-rules       Do not append prompts/local-lean-rules.md
  --bare           Skip global AGENTS.md / CLAUDE.md context files for minimum tokens
  --no-autostart   Do not automatically stop or start local model servers
  --stop-all       Stop Inkling (18089), Surogate (18091), Ornith (18092), and quit oMLX.app (8000)
  --pick           Force the interactive model picker even with --print-cmd
  --print-cmd      Print the resolved pi command and exit without running servers or pi
  -h, --help       Show this help and exit

All remaining flags and arguments pass directly to pi (for example: -p, -c, -r, --no-session).

Examples:
  pi-local                    # Open picker, auto-swap/start server, launch Pi
  pi-local --bare             # Open picker with minimal prompt mode
  pi-local --inkling          # Launch Inkling directly without picker
  pi-local --ornith --preflight --auto-critic
  pi-local --surogate         # Launch Surogate 3.7 Flash (Splash DFlash2)
  pi-local --stop-all         # Free all local GPU RAM
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --inkling)
      MODEL="$INKLING_MODEL"
      MODEL_EXPLICIT=1
      if [[ "$THINK_EXPLICIT" == "0" ]]; then
        THINK="medium"
      fi
      shift
      ;;
    --ornith)
      MODEL="$ORNITH_SPLASH_MODEL"
      MODEL_EXPLICIT=1
      if [[ "$THINK_EXPLICIT" == "0" ]]; then
        THINK="high"
      fi
      shift
      ;;
    --ornith-omlx)
      MODEL="$ORNITH_OMLX_MODEL"
      MODEL_EXPLICIT=1
      if [[ "$THINK_EXPLICIT" == "0" ]]; then
        THINK="high"
      fi
      shift
      ;;
    --surogate)
      MODEL="$SUROGATE_MODEL"
      MODEL_EXPLICIT=1
      if [[ "$THINK_EXPLICIT" == "0" ]]; then
        THINK="high"
      fi
      shift
      ;;
    --model)
      if [[ $# -lt 2 ]]; then
        print -u2 "Error: --model requires an argument"
        exit 2
      fi
      MODEL="$2"
      MODEL_EXPLICIT=1
      shift 2
      ;;
    --think)
      if [[ $# -lt 2 ]]; then
        print -u2 "Error: --think requires an argument"
        exit 2
      fi
      THINK="$2"
      THINK_EXPLICIT=1
      shift 2
      ;;
    --no-think)
      THINK="off"
      THINK_EXPLICIT=1
      shift
      ;;
    --hashline)
      USE_HASHLINE="1"
      shift
      ;;
    --no-hashline)
      USE_HASHLINE="0"
      shift
      ;;
    --codemode)
      USE_CODEMODE=1
      shift
      ;;
    --preflight)
      USE_PREFLIGHT=1
      shift
      ;;
    --auto-critic)
      AUTO_CRITIC=1
      shift
      ;;
    --adaptive-think)
      ADAPTIVE_THINK=1
      shift
      ;;
    --trace)
      TRACE_ENABLED=1
      shift
      ;;
    --no-goal-gate)
      USE_GOAL_GATE=0
      shift
      ;;
    --no-critic)
      USE_CRITIC=0
      shift
      ;;
    --subagents)
      USE_SUBAGENTS=1
      shift
      ;;
    --no-phase-tool)
      USE_PHASE_TOOL=0
      shift
      ;;
    --no-context-guard)
      USE_CONTEXT_GUARD=0
      shift
      ;;
    --legacy-speed)
      USE_LEGACY_SPEED=1
      shift
      ;;
    --no-rules)
      USE_RULES=0
      shift
      ;;
    --bare)
      NO_AGENTS_MD=1
      shift
      ;;
    --no-autostart)
      NO_AUTOSTART=1
      shift
      ;;
    --stop-all)
      STOP_ALL=1
      shift
      ;;
    --pick)
      FORCE_PICK=1
      shift
      ;;
    --print-cmd)
      PRINT_CMD=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

IS_PRINT_MODE=0
for arg in "$@"; do
  if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
    IS_PRINT_MODE=1
    break
  fi
done

port_http_code() {
  local url="$1"
  local code="000"
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "$url" 2>/dev/null || true)
  if [[ -z "$code" ]]; then
    code="000"
  fi
  print -r -- "$code"
}

find_inkling_bin() {
  if command -v inkling-omlx >/dev/null 2>&1; then
    command -v inkling-omlx
    return 0
  fi
  if [[ -x "$HOME/.local/bin/inkling-omlx" ]]; then
    print -r -- "$HOME/.local/bin/inkling-omlx"
    return 0
  fi
  return 1
}

find_surogate_bin() {
  if command -v surogate-splash >/dev/null 2>&1; then
    command -v surogate-splash
    return 0
  fi
  if [[ -x "$HOME/.local/bin/surogate-splash" ]]; then
    print -r -- "$HOME/.local/bin/surogate-splash"
    return 0
  fi
  return 1
}

surogate_splash_running() {
  pgrep -f -- "splash-1\.7\.0-m1 serve .*--port 18091" >/dev/null 2>&1
}

stop_surogate() {
  local bin=""
  if bin=$(find_surogate_bin); then
    "$bin" stop >&2
    return 0
  fi
  if surogate_splash_running; then
    pkill -TERM -f -- "splash-1\.7\.0-m1 serve .*--port 18091" 2>/dev/null || true
    sleep 1
    pkill -KILL -f -- "splash-1\.7\.0-m1 serve .*--port 18091" 2>/dev/null || true
  fi
}

start_surogate() {
  local bin=""
  bin=$(find_surogate_bin) || {
    print -u2 "Error: surogate-splash launcher not found in PATH or $HOME/.local/bin/surogate-splash"
    exit 1
  }
  "$bin" start >&2
}

find_ornith_splash_bin() {
  if command -v ornith-splash >/dev/null 2>&1; then
    command -v ornith-splash
    return 0
  fi
  if [[ -x "$HOME/.local/bin/ornith-splash" ]]; then
    print -r -- "$HOME/.local/bin/ornith-splash"
    return 0
  fi
  return 1
}

ornith_splash_running() {
  pgrep -f -- "splash-1\.7\.0-m1 serve .*--port 18092" >/dev/null 2>&1
}

stop_ornith_splash() {
  local bin=""
  if bin=$(find_ornith_splash_bin); then
    "$bin" stop >&2
    return 0
  fi
  if ornith_splash_running; then
    pkill -TERM -f -- "splash-1\.7\.0-m1 serve .*--port 18092" 2>/dev/null || true
    sleep 1
    pkill -KILL -f -- "splash-1\.7\.0-m1 serve .*--port 18092" 2>/dev/null || true
  fi
}

start_ornith_splash() {
  local bin=""
  bin=$(find_ornith_splash_bin) || {
    print -u2 "Error: ornith-splash launcher not found in PATH or $HOME/.local/bin/ornith-splash"
    exit 1
  }
  "$bin" start >&2
}

ornith_app_running() {
  pgrep -f "/Applications/oMLX\.app/Contents/MacOS/oMLX" >/dev/null 2>&1 || pgrep -x "oMLX" >/dev/null 2>&1
}

stop_inkling() {
  local bin=""
  bin=$(find_inkling_bin) || {
    print -u2 "Error: inkling-omlx launcher not found in PATH or $HOME/.local/bin/inkling-omlx"
    exit 1
  }
  "$bin" stop >&2
}

start_inkling() {
  local bin=""
  bin=$(find_inkling_bin) || {
    print -u2 "Error: inkling-omlx launcher not found in PATH or $HOME/.local/bin/inkling-omlx"
    exit 1
  }
  "$bin" start >&2
}

stop_ornith() {
  osascript -e 'tell application "oMLX" to quit' >/dev/null 2>&1 || true
  local stopped=0
  local pkill_sent=0
  local code=""
  for i in {1..40}; do
    code=$(port_http_code "http://127.0.0.1:8000/v1/models")
    if [[ "$code" == "000" ]] && ! ornith_app_running; then
      stopped=1
      break
    fi
    if [[ "$pkill_sent" == "0" && "$i" -ge 6 ]]; then
      pkill -TERM -x oMLX >/dev/null 2>&1 || true
      pkill_sent=1
    fi
    sleep 0.5
  done
  if [[ "$stopped" != "1" ]]; then
    print -u2 "Error: oMLX desktop app on port 8000 did not stop cleanly. Quit oMLX manually first so both models do not compete for 64 GiB RAM."
    exit 1
  fi
}

start_ornith() {
  if [[ ! -d "/Applications/oMLX.app" ]]; then
    print -u2 "Error: /Applications/oMLX.app not found."
    exit 1
  fi
  open -g -a /Applications/oMLX.app
  local ready=0
  local code=""
  for _ in {1..90}; do
    code=$(port_http_code "http://127.0.0.1:8000/v1/models")
    if [[ "$code" != "000" ]]; then
      ready=1
      break
    fi
    sleep 0.5
  done
  if [[ "$ready" != "1" ]]; then
    print -u2 "Error: oMLX desktop server did not answer on http://127.0.0.1:8000 within 45 seconds. Open oMLX.app and check that Ornith server startup is enabled."
    exit 1
  fi
}

INKLING_CODE=$(port_http_code "http://127.0.0.1:18089/v1/models")
ORNITH_SPLASH_CODE=$(port_http_code "http://127.0.0.1:18092/v1/models")
ORNITH_CODE=$(port_http_code "http://127.0.0.1:8000/v1/models")
SUROGATE_CODE=$(port_http_code "http://127.0.0.1:18091/v1/models")

INKLING_UP=0
[[ "$INKLING_CODE" != "000" ]] && INKLING_UP=1

ORNITH_SPLASH_UP=0
[[ "$ORNITH_SPLASH_CODE" != "000" ]] && ORNITH_SPLASH_UP=1

ORNITH_UP=0
[[ "$ORNITH_CODE" != "000" ]] && ORNITH_UP=1

SUROGATE_UP=0
[[ "$SUROGATE_CODE" != "000" ]] && SUROGATE_UP=1

stop_all_models() {
  if [[ "$INKLING_UP" == "1" ]]; then
    print -u2 "Stopping inkling-omlx (port 18089)..."
    stop_inkling
  fi
  if [[ "$SUROGATE_UP" == "1" ]] || surogate_splash_running; then
    print -u2 "Stopping surogate-splash (port 18091)..."
    stop_surogate
  fi
  if [[ "$ORNITH_SPLASH_UP" == "1" ]] || ornith_splash_running; then
    print -u2 "Stopping ornith-splash (port 18092)..."
    stop_ornith_splash
  fi
  if [[ "$ORNITH_UP" == "1" ]] || ornith_app_running; then
    print -u2 "Stopping oMLX desktop app (port 8000)..."
    stop_ornith
  fi
  print -u2 "All local models stopped."
  exit 0
}

if [[ "$STOP_ALL" == "1" ]]; then
  if [[ "$PRINT_CMD" == "1" ]]; then
    print -r -- "stop-all: would stop inkling-omlx, surogate-splash, ornith-splash, and quit oMLX.app"
    exit 0
  fi
  stop_all_models
fi

if [[ "$FORCE_PICK" == "1" ]] || { [[ "$MODEL_EXPLICIT" == "0" && "$PRINT_CMD" == "0" && "$IS_PRINT_MODE" == "0" && -t 0 && -t 1 ]]; }; then
  INKLING_STATUS="stopped"
  [[ "$INKLING_UP" == "1" ]] && INKLING_STATUS="running"

  ORNITH_STATUS="stopped"
  [[ "$ORNITH_SPLASH_UP" == "1" ]] && ORNITH_STATUS="running (splash)"
  [[ "$ORNITH_UP" == "1" && "$ORNITH_SPLASH_UP" == "0" ]] && ORNITH_STATUS="running (oMLX.app)"

  SUROGATE_STATUS="stopped"
  [[ "$SUROGATE_UP" == "1" ]] && SUROGATE_STATUS="running"

  DEFAULT_CHOICE="1"
  if [[ "$SUROGATE_UP" == "1" && "$INKLING_UP" == "0" && "$ORNITH_SPLASH_UP" == "0" && "$ORNITH_UP" == "0" ]]; then
    DEFAULT_CHOICE="3"
  elif [[ ( "$ORNITH_SPLASH_UP" == "1" || "$ORNITH_UP" == "1" ) && "$INKLING_UP" == "0" && "$SUROGATE_UP" == "0" ]]; then
    DEFAULT_CHOICE="2"
  fi

  print -u2 ""
  print -u2 "pi-local: choose local model"
  print -u2 "  1) Inkling 2 Mini (128K, port 18089)        [$INKLING_STATUS]"
  print -u2 "  2) Ornith 1.5 35B-A3B (128K, port 18092)   [$ORNITH_STATUS]"
  print -u2 "  3) Surogate 3.7 Flash (128K, port 18091)   [$SUROGATE_STATUS]"
  print -u2 "  4) Stop all local models and exit"
  printf "Select [1-4] (default %s): " "$DEFAULT_CHOICE" >&2

  choice=""
  IFS= read -r choice || choice=""
  choice="${choice:-$DEFAULT_CHOICE}"

  case "$choice" in
    1)
      MODEL="$INKLING_MODEL"
      if [[ "$THINK_EXPLICIT" == "0" ]]; then
        THINK="medium"
      fi
      ;;
    2)
      MODEL="$ORNITH_SPLASH_MODEL"
      if [[ "$THINK_EXPLICIT" == "0" ]]; then
        THINK="high"
      fi
      ;;
    3)
      MODEL="$SUROGATE_MODEL"
      if [[ "$THINK_EXPLICIT" == "0" ]]; then
        THINK="high"
      fi
      ;;
    4)
      if [[ "$PRINT_CMD" == "1" ]]; then
        print -r -- "stop-all: would stop inkling-omlx, surogate-splash, ornith-splash, and quit oMLX.app"
        exit 0
      fi
      stop_all_models
      ;;
    *)
      print -u2 "Invalid selection: $choice"
      exit 2
      ;;
  esac
fi

if [[ "$PRINT_CMD" == "1" || "$NO_AUTOSTART" == "1" ]]; then
  if [[ "$MODEL" == inkling-local/* ]]; then
    if [[ "$INKLING_UP" == "0" ]]; then
      print -u2 "Warning: inkling-omlx is not reachable on http://127.0.0.1:18089 (start it with: inkling-omlx start)"
    fi
    if [[ "$ORNITH_UP" != "0" ]]; then
      print -u2 "Note: oMLX desktop port 8000 is also listening. Unload Ornith before heavy Inkling sessions to protect browser RAM."
    fi
    if [[ "$ORNITH_SPLASH_UP" != "0" ]] || ornith_splash_running; then
      print -u2 "Warning: ornith-splash is also running on port 18092. Run 'ornith-splash stop' so both models do not compete for 64 GiB RAM."
    fi
    if [[ "$SUROGATE_UP" != "0" ]] || surogate_splash_running; then
      print -u2 "Warning: surogate-splash is also running on port 18091. Run 'surogate-splash stop' so both models do not compete for 64 GiB RAM."
    fi
  elif [[ "$MODEL" == surogate-local/* ]]; then
    if [[ "$SUROGATE_UP" == "0" ]]; then
      print -u2 "Warning: surogate-splash is not reachable on http://127.0.0.1:18091 (start it with: surogate-splash start)"
    fi
    if [[ "$INKLING_UP" != "0" ]]; then
      print -u2 "Warning: inkling-omlx is also running on port 18089. Run 'inkling-omlx stop' before using Surogate so both models do not compete for 64 GiB RAM."
    fi
    if [[ "$ORNITH_SPLASH_UP" != "0" ]] || ornith_splash_running; then
      print -u2 "Warning: ornith-splash is also running on port 18092. Run 'ornith-splash stop' before using Surogate so both models do not compete for 64 GiB RAM."
    fi
    if [[ "$ORNITH_UP" != "0" ]] || ornith_app_running; then
      print -u2 "Warning: oMLX desktop port 8000 is also listening. Quit oMLX.app before using Surogate so both models do not compete for 64 GiB RAM."
    fi
  elif [[ "$MODEL" == ornith-splash/* ]]; then
    if [[ "$ORNITH_SPLASH_UP" == "0" ]]; then
      print -u2 "Warning: ornith-splash is not reachable on http://127.0.0.1:18092 (start it with: ornith-splash start)"
    fi
    if [[ "$INKLING_UP" != "0" ]]; then
      print -u2 "Warning: inkling-omlx is also running on port 18089. Run 'inkling-omlx stop' before using Ornith so both models do not compete for 64 GiB RAM."
    fi
    if [[ "$SUROGATE_UP" != "0" ]] || surogate_splash_running; then
      print -u2 "Warning: surogate-splash is also running on port 18091. Run 'surogate-splash stop' before using Ornith so both models do not compete for 64 GiB RAM."
    fi
    if [[ "$ORNITH_UP" != "0" ]] || ornith_app_running; then
      print -u2 "Warning: oMLX desktop port 8000 is also listening. Quit oMLX.app before using ornith-splash so both models do not compete for 64 GiB RAM."
    fi
  elif [[ "$MODEL" == omlx-local/* || "$MODEL" == omlx/* ]]; then
    if [[ "$ORNITH_UP" == "0" ]]; then
      print -u2 "Warning: oMLX desktop server for Ornith is not reachable on http://127.0.0.1:8000 (open oMLX.app to start it)"
    fi
    if [[ "$INKLING_UP" != "0" ]]; then
      print -u2 "Warning: inkling-omlx is also running on port 18089. Run 'inkling-omlx stop' before using Ornith so both models do not compete for 64 GiB RAM."
    fi
    if [[ "$SUROGATE_UP" != "0" ]] || surogate_splash_running; then
      print -u2 "Warning: surogate-splash is also running on port 18091. Run 'surogate-splash stop' before using Ornith so both models do not compete for 64 GiB RAM."
    fi
    if [[ "$ORNITH_SPLASH_UP" != "0" ]] || ornith_splash_running; then
      print -u2 "Warning: ornith-splash is also running on port 18092. Run 'ornith-splash stop' before using oMLX.app so both models do not compete for 64 GiB RAM."
    fi
  fi
else
  if [[ "$MODEL" == inkling-local/* ]]; then
    if [[ "$ORNITH_UP" == "1" ]] || ornith_app_running; then
      print -u2 "Stopping oMLX desktop app (Ornith) to free RAM for Inkling..."
      stop_ornith
    fi
    if [[ "$ORNITH_SPLASH_UP" == "1" ]] || ornith_splash_running; then
      print -u2 "Stopping ornith-splash to free RAM for Inkling..."
      stop_ornith_splash
    fi
    if [[ "$SUROGATE_UP" == "1" ]] || surogate_splash_running; then
      print -u2 "Stopping surogate-splash to free RAM for Inkling..."
      stop_surogate
    fi
    if [[ "$INKLING_UP" == "0" ]]; then
      print -u2 "Starting inkling-omlx (128K + 6GB hot cache)..."
      start_inkling
    fi
  elif [[ "$MODEL" == surogate-local/* ]]; then
    if [[ "$INKLING_UP" == "1" ]]; then
      print -u2 "Stopping inkling-omlx to free RAM for Surogate..."
      stop_inkling
    fi
    if [[ "$ORNITH_SPLASH_UP" == "1" ]] || ornith_splash_running; then
      print -u2 "Stopping ornith-splash to free RAM for Surogate..."
      stop_ornith_splash
    fi
    if [[ "$ORNITH_UP" == "1" ]] || ornith_app_running; then
      print -u2 "Stopping oMLX desktop app (Ornith) to free RAM for Surogate..."
      stop_ornith
    fi
    if [[ "$SUROGATE_UP" == "0" ]]; then
      print -u2 "Starting surogate-splash (128K + DFlash2 + thinking cap)..."
      start_surogate
    fi
  elif [[ "$MODEL" == ornith-splash/* ]]; then
    if [[ "$INKLING_UP" == "1" ]]; then
      print -u2 "Stopping inkling-omlx to free RAM for Ornith..."
      stop_inkling
    fi
    if [[ "$SUROGATE_UP" == "1" ]] || surogate_splash_running; then
      print -u2 "Stopping surogate-splash to free RAM for Ornith..."
      stop_surogate
    fi
    if [[ "$ORNITH_UP" == "1" ]] || ornith_app_running; then
      print -u2 "Stopping oMLX desktop app to free RAM for ornith-splash..."
      stop_ornith
    fi
    if [[ "$ORNITH_SPLASH_UP" == "0" ]]; then
      print -u2 "Starting ornith-splash (128K + resident experts + native DFlash2 + thinking cap)..."
      start_ornith_splash
    fi
  elif [[ "$MODEL" == omlx-local/* || "$MODEL" == omlx/* ]]; then
    if [[ "$INKLING_UP" == "1" ]]; then
      print -u2 "Stopping inkling-omlx to free RAM for Ornith..."
      stop_inkling
    fi
    if [[ "$SUROGATE_UP" == "1" ]] || surogate_splash_running; then
      print -u2 "Stopping surogate-splash to free RAM for Ornith..."
      stop_surogate
    fi
    if [[ "$ORNITH_SPLASH_UP" == "1" ]] || ornith_splash_running; then
      print -u2 "Stopping ornith-splash to free RAM for oMLX desktop app..."
      stop_ornith_splash
    fi
    if [[ "$ORNITH_UP" == "0" ]]; then
      print -u2 "Starting oMLX desktop app for Ornith on port 8000..."
      start_ornith
    fi
  fi
fi

ARGS=(
  --model "${MODEL}:${THINK}"
  --no-mcp
  --no-skills
  --no-extensions
)
if [[ "$USE_CODEMODE" != "1" ]]; then
  ARGS+=(--exclude-tools codemode)
fi

if [[ "$NO_AGENTS_MD" == "1" ]]; then
  ARGS+=(--no-context-files)
fi

if [[ "$USE_RULES" == "1" && -f "$REPO_DIR/prompts/local-lean-rules.md" ]]; then
  ARGS+=(--append-system-prompt "$REPO_DIR/prompts/local-lean-rules.md")
fi

if [[ "$USE_PREFLIGHT" == "1" ]] && [[ -x "$REPO_DIR/bin/pi-preflight" ]]; then
  if [[ "$PRINT_CMD" == "1" ]]; then
    ARGS+=(--append-system-prompt "<workspace_preflight_snapshot>")
  else
    PREFLIGHT_TEXT=$("$REPO_DIR/bin/pi-preflight" "$PWD" 2>/dev/null || true)
    if [[ -n "$PREFLIGHT_TEXT" ]]; then
      ARGS+=(--append-system-prompt "$PREFLIGHT_TEXT")
    fi
  fi
fi

LOCAL_EXT_ROOT="$HOME/.local/share/pi-local-extensions/node_modules"
GLOBAL_EXT_ROOT="$HOME/.pi/agent/npm/node_modules"

add_ext() {
  local ext_path="$1"
  if [[ -f "$ext_path" ]]; then
    ARGS+=(-e "$ext_path")
  fi
}

HASHLINE_ACTIVE=0
if [[ "$USE_HASHLINE" == "1" ]]; then
  HASHLINE_ACTIVE=1
elif [[ "$USE_HASHLINE" == "auto" ]] && [[ "$MODEL" == surogate-local/* || "$MODEL" == ornith-splash/* || "$MODEL" == omlx-local/* ]]; then
  HASHLINE_ACTIVE=1
fi
if [[ "$HASHLINE_ACTIVE" == "1" ]]; then
  add_ext "$LOCAL_EXT_ROOT/pi-hashline-edit/index.ts"
fi

if [[ "$USE_PHASE_TOOL" == "1" ]]; then
  add_ext "$REPO_DIR/extensions/local-phase-handoff.ts"
fi
if [[ "$USE_CONTEXT_GUARD" == "1" ]]; then
  add_ext "$REPO_DIR/extensions/local-context-guard.ts"
fi
if [[ "$USE_GOAL_GATE" == "1" ]]; then
  add_ext "$REPO_DIR/extensions/local-goal-gate.ts"
fi
if [[ "$USE_CRITIC" == "1" ]]; then
  add_ext "$REPO_DIR/extensions/local-critic.ts"
fi

add_ext "$LOCAL_EXT_ROOT/pi-handoff/extensions/handoff.ts"
if [[ "$USE_SUBAGENTS" == "1" ]]; then
  add_ext "$LOCAL_EXT_ROOT/pi-subagents/bundle/index.js"
fi

if [[ "$USE_LEGACY_SPEED" == "1" ]]; then
  add_ext "$GLOBAL_EXT_ROOT/pi-token-speed/src/index.ts"
else
  add_ext "$REPO_DIR/extensions/local-omlx-meter.ts"
fi
add_ext "$GLOBAL_EXT_ROOT/@erichll/pi-statusline/src/index.ts"
add_ext "$GLOBAL_EXT_ROOT/pi-tool-repair/tool-repair.ts"

if [[ "$AUTO_CRITIC" == "1" ]]; then
  export PI_LOCAL_AUTO_CRITIC=1
fi
if [[ "$ADAPTIVE_THINK" == "1" ]]; then
  export PI_LOCAL_ADAPTIVE_THINK=1
fi
if [[ "$TRACE_ENABLED" == "1" ]]; then
  export PI_LOCAL_TRACE=1
fi

if [[ "$PRINT_CMD" == "1" ]]; then
  print -r -- "pi ${(q-)ARGS[@]} ${(q-)@}"
  exit 0
fi

exec pi "${ARGS[@]}" "$@"
